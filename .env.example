# EterDB local configuration.

# Postgres the eter engine runs on (direct mode: CLI -> Postgres).
DATABASE_URL=postgres://eter:eter@localhost:5432/eter

# DSN of a separate EterDB-owned metadata store that holds durable eter.*
# metadata (history, dependency graph, backup catalog, …) OUT of the tenant DB.
# REQUIRED by the deployment runtime (the capture/storage sidecars +
# orchestrator, issue #67): it must point at a SEPARATE database so metadata
# survives tenant loss — those processes refuse to start without it. For a
# zero-infra single-DB dev/demo, leave it unset and set ETER_ALLOW_SINGLE_DB=1
# to acknowledge that the store IS the tenant DB. (The `eter` CLI's direct mode
# still defaults to single-DB on its own.)
ETER_META_URL=postgres://eter:eter@localhost:5433/eter_meta
# ETER_ALLOW_SINGLE_DB=1

# docker-compose Postgres bootstrap.
POSTGRES_USER=eter
POSTGRES_PASSWORD=eter
POSTGRES_DB=eter

# --- Capture sidecar (sidecars/capture) -------------------------------------
# ETER_SLOT=eter_slot
# ETER_PUBLICATION=eter_pub

# --- Storage sidecar (sidecars/storage; pg_basebackup + WAL-replay PITR) ----
# ETER_BACKUP_DIR=/var/lib/eter/backups
# ETER_WAL_ARCHIVE=/var/lib/eter/wal-archive
# Opt-in retention bounds for the (re-derivable) backups/WAL — history is never pruned.
# ETER_BACKUP_RETAIN_COUNT=8
# ETER_BACKUP_HORIZON_DAYS=90
